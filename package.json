{
  "name": "remorque",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "courriels": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/expedier-courriels.ts",
    "db:demo": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/amorcer-demonstration.ts",
    "db:generate": "drizzle-kit generate",
    "db:vitrine": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/amorcer-vitrine.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:prepare": "tsx --env-file-if-exists=.env.local scripts/preparer-base.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local src/server/db/seed.ts",
    "db:setup": "npm run db:prepare && npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "rappels": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/poser-rappels.ts",
    "taches": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/taches-quotidiennes.ts",
    "db:verifier": "tsx --env-file-if-exists=.env.local scripts/verifier-base.ts",
    "dev": "next dev",
    "lint": "eslint",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "description": "Place de marche europeenne de location de remorques"
}
