# Copier ce fichier en `.env.local` et renseigner les valeurs.
# Aucun secret réel ne doit être committé.

NODE_ENV=development

# --- Base de données -------------------------------------------------------
# Docker Compose fourni : `docker compose up -d` puis cette adresse.
# En hébergement managé, choisir impérativement une région européenne
# (section 11 — protection des données).
DATABASE_URL=postgresql://remorque:remorque@localhost:5432/remorque

# --- Cache et files d'attente ---------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Authentification ------------------------------------------------------
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Paiement (Stripe Connect) ---------------------------------------------
# Clés de test uniquement en développement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stockage objet (photos d'annonces et d'états des lieux) ---------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Client ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=
