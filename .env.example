# Copier ce fichier en `.env.local` et renseigner les valeurs.
# Aucun secret réel ne doit être committé.

NODE_ENV=development

# --- Base de données (Supabase) --------------------------------------------
# Deux adresses, à ne pas confondre — elles se trouvent dans le tableau de bord
# Supabase, sous « Connect ».
#
# 1. DATABASE_URL — gestionnaire de connexions (Supavisor, port 6543).
#    Utilisée par l'application. Indispensable sur Vercel, où chaque requête
#    peut ouvrir sa propre connexion.
DATABASE_URL=postgresql://postgres.REFERENCE:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# 2. DATABASE_URL_DIRECT — connexion directe (port 5432).
#    Réservée aux migrations et aux scripts d'administration : le gestionnaire
#    de connexions travaille en mode transaction et ne sait pas exécuter les
#    instructions de définition de schéma.
DATABASE_URL_DIRECT=postgresql://postgres.REFERENCE:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# Choisir impérativement une région européenne (section 11 du cadrage —
# protection des données). `eu-central-1` (Francfort) ou `eu-west-3` (Paris).

# --- Cache et files d'attente ---------------------------------------------
# Facultatif tant que les tâches différées ne sont pas branchées.
REDIS_URL=

# --- Authentification ------------------------------------------------------
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Paiement (Stripe Connect) ---------------------------------------------
# Clés de test uniquement en développement (`sk_test_…`).
#
# Sans ces deux valeurs, le paiement en ligne est fermé : le bouton « Régler la
# location » le dit à l'usager, et le point d'entrée des événements répond 503
# plutôt que d'acquitter en silence. Protocole de recette : docs/recette-stripe.md
STRIPE_SECRET_KEY=
# Rendu par `stripe listen` en développement (`whsec_…`), ou par le tableau de
# bord Stripe pour un point d'entrée déclaré.
STRIPE_WEBHOOK_SECRET=

# --- Courriels sortants ----------------------------------------------------
# Sans clé, les notifications restent en file d'attente : rien n'est marqué
# envoyé sans l'avoir été. `npm run courriels` affiche alors ce qui partirait.
RESEND_API_KEY=
COURRIEL_EXPEDITEUR=

# --- Stockage objet (photos d'annonces et d'états des lieux) ---------------
# Supabase Storage est compatible S3 : les valeurs se trouvent sous
# « Storage » → « S3 Connection ».
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Client ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=
